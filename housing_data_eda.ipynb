   "source": [
    "# \ud83c\udfe1 Housing Market Data - Exploratory Data Analysis (EDA)\n",
    "This notebook explores the housing dataset to uncover trends, clean data, perform feature engineering, and prepare metrics for the Power BI dashboard."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Import required libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Set plotting style for professional visuals\n",
    "sns.set_theme(style=\"whitegrid\", palette=\"muted\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Load the dataset\n",
    "# Assuming the CSV is in the same directory\n",
    "df = pd.read_csv('Housing Data.csv')\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Dataset Information and Data Types\n",
    "df.info()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Summary Statistics for numerical columns\n",
    "display(df.describe().round(2))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Data Cleaning: Check for missing values\n",
    "missing_values = df.isnull().sum()\n",
    "print(\"Missing values per column:\\n\")\n",
    "print(missing_values[missing_values > 0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. Feature Engineering: Calculate property age and price per square meter\n",
    "df['date'] = pd.to_datetime(df['date'])\n",
    "df['sales_year'] = df['date'].dt.year\n",
    "\n",
    "# Property age at the time of sale\n",
    "df['property_age_at_sale'] = df['sales_year'] - df['year_build']\n",
    "\n",
    "# Price per square meter\n",
    "df['price_per_sqm'] = df['purchase_price'] / df['sqm']\n",
    "df[['house_id', 'property_age_at_sale', 'price_per_sqm']].head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 7. Visualization: Distribution of Purchase Prices\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.histplot(df['purchase_price'], bins=50, kde=True, color='#3498db')\n",
    "plt.title('Distribution of Property Purchase Prices', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Purchase Price')\n",
    "plt.ylabel('Frequency')\n",
    "# Setting x-axis limits to ignore massive outliers for better visualization\n",
    "plt.xlim(0, df['purchase_price'].quantile(0.95))\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 8. Visualization: Sales Volume by Region\n",
    "plt.figure(figsize=(12, 6))\n",
    "region_counts = df['region'].value_counts()\n",
    "sns.barplot(x=region_counts.index, y=region_counts.values, palette='viridis')\n",
    "plt.title('Total Units Sold by Region', fontsize=14, fontweight='bold')\n",
    "plt.xticks(rotation=45)\n",
    "plt.ylabel('Number of Units')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 9. Visualization: Offer Price vs Purchase Price Negotiation margins\n",
    "plt.figure(figsize=(8, 8))\n",
    "sns.scatterplot(x='Offer_Price', y='purchase_price', data=df, alpha=0.3, color='#e74c3c')\n",
    "\n",
    "# Plotting y=x line for reference (where offer == purchase)\n",
    "max_val = max(df['Offer_Price'].max(), df['purchase_price'].max())\n",
    "plt.plot([0, max_val], [0, max_val], color='black', linestyle='--')\n",
    "plt.title('Offer Price vs Final Purchase Price', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Offer Price')\n",
    "plt.ylabel('Purchase Price')\n",
    "plt.xlim(0, max_val * 0.1) # Zoom in to see the dense area\n",
    "plt.ylim(0, max_val * 0.1)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 10. Visualization: Average Price per SQM by House Type\n",
    "plt.figure(figsize=(10, 6))\n",
    "avg_price_sqm = df.groupby('house_type')['price_per_sqm'].mean().sort_values(ascending=False)\n",
    "sns.barplot(x=avg_price_sqm.index, y=avg_price_sqm.values, palette='mako')\n",
    "plt.title('Average Price per Square Meter by House Type', fontsize=14, fontweight='bold')\n",
    "plt.ylabel('Avg Price / SQM')\n",
    "plt.xlabel('House Type')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 11. Correlation Heatmap for Macroeconomic Impact\n",
    "numeric_df = df.select_dtypes(include=[np.number])\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.heatmap(numeric_df.corr(), annot=True, cmap='coolwarm', fmt=\".2f\", linewidths=0.5)\n",
    "plt.title('Correlation Matrix: Housing Metrics & Macroeconomics', fontsize=16, fontweight='bold')\n",
    "plt.show()"
   ]
  }
 ],
